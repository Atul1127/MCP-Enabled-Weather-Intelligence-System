# Required for the Gemini agent
GEMINI_API_KEY=

# PostgreSQL + pgvector
DATABASE_BACKEND=local
DATABASE_URL=postgresql://weather_user:change-me@localhost:5432/weather_rag
WEATHER_RAG_BACKEND=postgres
WEATHER_RAG_DENSE=0
WEATHER_RAG_REQUIRE_SCHEMA=1
POSTGRES_DB=weather_rag
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=change-me

# Database safety limits
WEATHER_DB_CONNECT_TIMEOUT=10
WEATHER_DB_STATEMENT_TIMEOUT_MS=10000
WEATHER_DB_LOCK_TIMEOUT_MS=5000

# Gemini behavior
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=700

# Agent / MCP limits
WEATHER_AGENT_MAX_ROUNDS=4
WEATHER_AGENT_MAX_RETRIES=1
WEATHER_MAX_TOOL_CALLS=16
WEATHER_MCP_TIMEOUT=20
WEATHER_RAG_MCP_TIMEOUT=12
WEATHER_MCP_RETRIES=1

# Observability
WEATHER_TRACE_PATH=observability/traces.jsonl

# Evaluation
WEATHER_STRESS_LIMIT=512

# Keep synchronization disabled unless explicitly secured
WEATHER_ALLOW_SYNC=0
# WEATHER_ADMIN_API_KEY=

# Persistent MCP session (set 0 to spawn one MCP server per request, old behaviour)
WEATHER_MCP_PERSISTENT=1
WEATHER_MCP_STARTUP_TIMEOUT=60

# Caches and Nominatim politeness (seconds)
WEATHER_GEOCODE_CACHE_SECONDS=604800
WEATHER_GEOCODE_MISS_CACHE_SECONDS=3600
WEATHER_FORECAST_CACHE_SECONDS=600
WEATHER_NOMINATIM_MIN_INTERVAL=1.0

# Per-IP rate limits ("N/second|minute|hour"); set WEATHER_TRUST_PROXY=1 behind Railway's proxy
WEATHER_AGENT_RATE_LIMIT=10/minute
WEATHER_ASK_RATE_LIMIT=20/minute
WEATHER_TRUST_PROXY=1

# Stress eval: set 0 to skip the 30 held-out questions
WEATHER_STRESS_HELD_OUT=1
