# Required for the Gemini agent
GEMINI_API_KEY=

# PostgreSQL + pgvector
DATABASE_BACKEND=local
DATABASE_URL=postgresql://weather_user:change-me@localhost:5432/weather_rag
WEATHER_RAG_BACKEND=postgres
WEATHER_RAG_DENSE=0
WEATHER_RAG_REQUIRE_SCHEMA=1
POSTGRES_DB=weather_rag
POSTGRES_USER=weather_user
POSTGRES_PASSWORD=change-me

# Database safety limits
WEATHER_DB_CONNECT_TIMEOUT=10
WEATHER_DB_STATEMENT_TIMEOUT_MS=10000
WEATHER_DB_LOCK_TIMEOUT_MS=5000

# Gemini behavior
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=low
GEMINI_MAX_OUTPUT_TOKENS=700

# Agent / MCP limits
WEATHER_AGENT_MAX_ROUNDS=4
WEATHER_AGENT_MAX_RETRIES=1
WEATHER_MAX_TOOL_CALLS=16
WEATHER_MCP_TIMEOUT=20
WEATHER_RAG_MCP_TIMEOUT=12
WEATHER_MCP_RETRIES=1

# Observability
WEATHER_TRACE_PATH=observability/traces.jsonl

# Evaluation
WEATHER_STRESS_LIMIT=512

# Keep synchronization disabled unless explicitly secured
WEATHER_ALLOW_SYNC=0
# WEATHER_ADMIN_API_KEY=
